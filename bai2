#include <stdio.h>
#include <math.h>

void kiemTraSoNguyenTo(int n) {
    if (n < 2) {
        printf("%d khong la so nguyen to.\n", n);
        return;
    }

    int laNguyenTo = 1;
    int canN = (int)sqrt(n);

    for (int i = 2; i <= canN; i++) {
        if (n % i == 0) {
            laNguyenTo = 0; // Tìm thấy ước số -> không phải SNT
            break;
        }
    }

    if (laNguyenTo) {
        printf("%d la so nguyen to.\n", n);
    } else {
        printf("%d khong la so nguyen to.\n", n);
    }
}

int main() {
    int n;
    printf("Nhap N (> 0): ");
    scanf("%d", &n);

    kiemTraSoNguyenTo(n);

    return 0;
}
