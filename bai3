#include <stdio.h>

int main() {
    int n;
    printf("Nhap so luong phan tu n: ");
    scanf("%d", &n);

    if (n < 1) {
        printf("Mang rong!\n");
        return 0;
    }

    int a[1000];
    printf("Nhap các phan tu cua mang:\n");
    for (int i = 0; i < n; i++) {
        printf("A[%d] = ", i + 1);
        scanf("%d", &a[i]);
    }

    int max = a[0];

    for (int i = 1; i < n; i++) {
        if (a[i] > max) {
            max = a[i];
        }
    }

    printf("\nSo lon nhat trong mang la: %d\n", max);

    return 0;
}
