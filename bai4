#include <stdio.h>
int main() {
    int a, b;
    printf("Nhap so nguyen duong a: ");
    scanf("%d", &a);
    printf("Nhap so nguyen duong b: ");
    scanf("%d", &b);

    if (a <= 0 || b <= 0) {
        printf("Vui long nhap 2 so nguyen duong!\n");
        return 0;
    }
    int x = a, y = b;
    while (y != 0) {
        int r = x % y;
        x = y;
        y = r;
    }
    int bcnn = (a / x) * b;
    printf("\nBCNN cua %d va %d la: %d\n", a, b, bcnn);
    return 0;
}
